node_modules/
node_modules
dist/
.env
.env.*
!.env.example
*.log
test-results/
# Playwright screen recordings — regenerated by the capture config, and the
# suite deletes the whole directory on each run, so tracking them means every
# capture shows up as six deletions and one modification.
capture-out/
playwright-report/
.playwright/
.DS_Store

# Never commit anything under here. Local scratch, recordings, key material.
private/

# Live-credential run output (recordings). Evidence copies live in the release bundle.
live-out/

# scripts/shot.mjs output — working evidence for a change under review, not repo content.
evidence/

# Local working notes. Never part of a clone.
.parity/

# Campaign runtime state: a lock means "a turn is working RIGHT NOW".
# Committing one would make a fresh clone look permanently in flight.
runs/*/.lock

# scripts/brand.mjs scratch — the banner is rendered from this, the PNG is the artifact.
misc/.banner.html
